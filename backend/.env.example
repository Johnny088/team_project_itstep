# backend/.env.example — ОБРАЗЕЦ.

# Как пользоваться:
#   1) cp .env.example .env                         (в папке backend)
#   2) в .env подставить свой DJANGO_SECRET_KEY     (команда ниже)
#   3) pip install -r requirements.txt
# Сам .env в git не попадает.


# Сгенерировать ключ:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Локально True, на проде False
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Локально: Vite (5173) и React (3000).
# Деплой: только реальный https-адрес фронтенда, без слэша на конце
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Локально False/Lax. На проде (HTTPS): True, а SameSite=None, если фронт на другом домене
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax